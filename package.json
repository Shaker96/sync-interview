{
  "name": "sync-interview",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=./test/reporter.mjs \"test/*.test.ts\"",
    "test:scenarios": "node --import tsx --test --test-reporter=./test/reporter.mjs test/1-scenarios.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
}
